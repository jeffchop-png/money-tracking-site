[Unit]
Description=Morg Money shared ledger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=morg-money
Group=morg-money
WorkingDirectory=/opt/morg-money
EnvironmentFile=/opt/morg-money/.env
ExecStart=/usr/bin/env node /opt/morg-money/server.js --serve-dist
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/morg-money/data

[Install]
WantedBy=multi-user.target
